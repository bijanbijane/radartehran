const FORBIDDEN_FAKE_USER_IDS = new Set([
  'current_local_user',
  'local-user',
  'anonymous',
  'guest'
]);

export function isRealAuthenticatedUid(uid: unknown): uid is string {
  if (typeof uid !== 'string') return false;
  const trimmed = uid.trim();
  return trimmed.length >= 2 &&
    !FORBIDDEN_FAKE_USER_IDS.has(trimmed);
}
تابع buildUserTrustProfile در خطوط ۵۲ تا ۵۵ همین اعتبارسنجی را انجام می‌دهد.
