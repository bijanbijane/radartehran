export interface CommunityHubPageProps {
  activeSubTab?: ContributionsSubTabId;
  selectedHood: EvaluatedNeighborhood;
  evaluatedNeighborhoods?: EvaluatedNeighborhood[];
  ...
}
سه ورودی currentUser، activeCity و isVerifiedAdmin در این قرارداد تعریف نشده‌اند.
این یک ناسازگاری TypeScript نیز ایجاد می‌کند که باید با اجرای Typecheck تأیید شود.
شاهد سوم: تولید هویت آزمایشی در صفحه
همان فایل، خطوط ۶۷ تا ۷۲:
const currentUserProfile = useMemo(
