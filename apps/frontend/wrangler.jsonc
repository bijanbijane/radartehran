{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "radartehran-frontend",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/manifest.json",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "WORKER_ENV": "development",
    "APP_URL": "http://localhost:3000"
  },
  "env": {
    "preview": {
      "name": "radartehran-frontend-preview",
      "vars": {
        "APP_ENV": "preview",
        "WORKER_ENV": "preview",
        "APP_URL": "https://preview.radartehran.ir"
      }
    },
    "staging": {
      "name": "radartehran-frontend-staging",
      "vars": {
        "APP_ENV": "staging",
        "WORKER_ENV": "staging",
        "APP_URL": "https://staging.radartehran.ir"
      }
    },
    "production": {
      "name": "radartehran-frontend",
      "services": [{ "binding": "RADAR_API", "service": "radartehran-api" }],
      "vars": {
        "APP_ENV": "production",
        "WORKER_ENV": "production",
        "APP_URL": "https://radartehran-frontend.bijanbijane-1.workers.dev"
      }
    }
  }
}