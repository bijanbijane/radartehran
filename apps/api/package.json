{
  "name": "radartehran-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tehran Radar Express API (server.ts, server/modules, src/utils/server*)",
  "scripts": {
    "dev": "tsx server.ts --port 3001",
    "start": "tsx server.ts --port 3001",
    "start:prod": "node ./scripts/start-production.mjs --port 3001",
    "build": "node ./scripts/build-production.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@radartehran/contracts": "0.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.7.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}