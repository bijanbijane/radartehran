{
  // ============================================================================
  // Tehran Radar Backend API Worker — RT-DB-TRIAD-001 Canonical Configuration
  // ============================================================================
  // Three Data Domains Architecture:
  //   1. USER_DB -> radar-user-db (Owned by Radar Tehran)
  //   2. RESEARCH_DB                 -> radar-researcher-db (Owned by Radar Tehran, isolated)
  //   3. IRNI Neighborhood Reference -> External Read-Only API Client ONLY
  //      ABSOLUTE PROHIBITION: radar-neighborhood-db (f335efe8-37ac-4c7d-a057-bc9f4480f6c6)
  //      is owned exclusively by the independent IRNI project and MUST NEVER be bound,
  //      queried, migrated, or written to directly by Tehran Radar.
  // ============================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radartehran-api",
  "account_id": "5bafb2033937006704e81afcc0b18b38",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2
  },

  // Production D1 bindings (default top-level environment: radartehran-api)
  // USER_DB is the sole canonical binding to radar-user-db.
  // RESEARCH_DB points to the physically isolated radar-researcher-db UUID with its own migrations_dir.
  "d1_databases": [
    {
      "binding": "USER_DB",
      "database_name": "radar-user-db",
      "database_id": "fbb98e6b-5200-4047-b4bc-15a51c06aa84",
      "migrations_dir": "migrations/user-d1",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "RESEARCH_DB",
      "database_name": "radar-researcher-db",
      "database_id": "a04f9716-fb95-44da-841c-b54be252db70",
      "migrations_dir": "migrations/research-d1",
      "migrations_table": "d1_migrations"
    }
  ],

  // Non-secret runtime configuration ONLY.
  // Required Cloudflare Worker Secrets (provision via `wrangler secret put`, NEVER in vars):
  //   - GOOGLE_OAUTH_CLIENT_SECRET\n  //   - KAVENEGAR_API_KEY\n  //   - AUTH_PII_HMAC_SECRET\n  //   - ADMIN_API_SECRET
  //   - R2_SIGNING_SECRET
  //   - RESEARCH_HMAC_SECRET
  //   - RESEARCH_HMAC_PREVIOUS_SECRETS (optional JSON map for key rotation during erasure)
  //   - INTERNAL_LIFECYCLE_RPC_SECRET
  //   - IRNI_API_TOKEN (blocked until external IRNI contract is delivered)
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://radartehran.ir",
    "RESEARCH_HMAC_KEY_VERSION": "v1",
    "RESEARCH_K_ANONYMITY_MIN_COHORT": "10",
    "IRNI_API_TIMEOUT_MS": "4000",
    "IRNI_CACHE_TTL_SECONDS": "900",
    "IRNI_STALE_TTL_SECONDS": "3600",
    "IRNI_API_CONTRACT_STATUS": "BLOCKED_EXTERNAL_IRNI_CONTRACT",
    "STRICT_ORIGIN_ENFORCEMENT": "true",
  },

  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/15 * * * *",
      "*/30 * * * *",
      "0 3 * * *"
    ]
  },

  "env": {
    // ========================================================================
    // STAGING ENVIRONMENT — STRICTLY ISOLATED FROM PRODUCTION DATABASES
    // ========================================================================
    // STATUS: BLOCKED_STAGING_DATABASES_NOT_PROVISIONED
    // Staging MUST NEVER bind Production D1 UUIDs (fbb98e6b... or a04f9716...).
    // Before deploying staging, provision dedicated staging D1 databases:
    //   1. wrangler d1 create radar-user-db-staging
    //   2. wrangler d1 create radar-researcher-db-staging
    //   3. wrangler kv namespace create radartehran-api-staging-kv
    // Then add staging d1_databases (USER_DB, RESEARCH_DB) and kv_namespaces below.
    "staging": {
      "name": "radartehran-api-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "https://radartehran-api-staging.workers.dev",
        "RESEARCH_HMAC_KEY_VERSION": "v1",
        "RESEARCH_K_ANONYMITY_MIN_COHORT": "10",
        "IRNI_API_TIMEOUT_MS": "4000",
        "IRNI_CACHE_TTL_SECONDS": "300",
        "IRNI_STALE_TTL_SECONDS": "1800",
        "IRNI_API_CONTRACT_STATUS": "BLOCKED_EXTERNAL_IRNI_CONTRACT",
        "STAGING_D1_PROVISIONING_STATUS": "BLOCKED_STAGING_DATABASES_NOT_PROVISIONED",
        "STRICT_ORIGIN_ENFORCEMENT": "false",
      }
    }
  }
}
