{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radartehran-api",
  "account_id": "5bafb2033937006704e81afcc0b18b38",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "production",
    "DB_WRITES_PAUSED_UNTIL_UTC": "2026-11-24T00:00:00Z",
    "WORKER_ENV": "production",
    "APP_URL": "https://radartehran-frontend.bijanbijane-1.workers.dev",
    "ADMIN_EMAIL": "radio837isf@gmail.com",
    "RESEARCH_HMAC_KEY_VERSION": "v1",
    "RESEARCH_K_ANONYMITY_MIN_COHORT": "10",
    "GEO_REGISTRY_EXPECTED_CONTRACT": "IRGEO-IDENTITY-1.0.0",
    "GEO_REGISTRY_EXPECTED_ID_ALGORITHM": "IRGEO1-SHA256-FULL-V1"
  },
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "WORKER_ENV": "preview",
      "APP_URL": "https://preview.invalid",
      "GEO_REGISTRY_EXPECTED_CONTRACT": "IRGEO-IDENTITY-1.0.0",
      "GEO_REGISTRY_EXPECTED_ID_ALGORITHM": "IRGEO1-SHA256-FULL-V1"
    }
  },
  "env": {
    "staging": {
      "name": "radartehran-api-staging",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": false,
          "head_sampling_rate": 1,
          "persist": true
        }
      },
      "vars": {
        "APP_ENV": "staging",
        "WORKER_ENV": "staging",
        "APP_URL": "https://staging.invalid"
      },
      "d1_databases": [
        {
          "binding": "USER_DB",
          "database_name": "radartehran-api-staging-user-db",
          "database_id": "c5048585-0c40-46da-97e5-97f9cd262cd0",
          "migrations_dir": "migrations/user-d1",
          "migrations_table": "d1_migrations"
        },
        {
          "binding": "DB",
          "database_name": "radartehran-api-staging-user-db",
          "database_id": "c5048585-0c40-46da-97e5-97f9cd262cd0",
          "migrations_dir": "migrations/user-d1",
          "migrations_table": "d1_migrations"
        },
        {
          "binding": "RESEARCH_DB",
          "database_name": "radartehran-api-staging-research-db",
          "database_id": "83d1165e-2c0a-4407-8a31-d79150915da4",
          "migrations_dir": "migrations/research-d1",
          "migrations_table": "d1_migrations"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "USER_DB",
      "database_name": "radar-user-db",
      "database_id": "fbb98e6b-5200-4047-b4bc-15a51c06aa84",
      "migrations_dir": "migrations/user-d1",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "DB",
      "database_name": "radar-user-db",
      "database_id": "fbb98e6b-5200-4047-b4bc-15a51c06aa84",
      "migrations_dir": "migrations/user-d1",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "RESEARCH_DB",
      "database_name": "radar-researcher-db",
      "database_id": "a04f9716-fb95-44da-841c-b54be252db70",
      "migrations_dir": "migrations/research-d1",
      "migrations_table": "d1_migrations"
    }
  ],
  "services": [
    {
      "binding": "IRNI_GEOGRAPHY",
      "service": "irni-api"
    }
  ]
}
