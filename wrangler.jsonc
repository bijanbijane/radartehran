{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radartehran",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/manifest.json",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:3000"
  },
  "env": {
    "preview": {
      "name": "radartehran-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_URL": "https://preview.radartehran.example.com"
      }
    },
    "staging": {
      "name": "radartehran-staging",
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "https://staging.radartehran.example.com"
      }
      // PENDING_PROVISIONING in Phase 10-B (Upon explicit user authorization):
      // - d1_databases: [{ binding: "DB", database_name: "radartehran-staging-db", database_id: "<TO_BE_PROVISIONED>" }]
      // - r2_buckets: [{ binding: "MEDIA_BUCKET", bucket_name: "radartehran-staging-media" }]
      // - kv_namespaces: [{ binding: "CACHE_KV", id: "<TO_BE_PROVISIONED>" }]
      // - queues.producers: [{ queue: "radar-background-jobs-staging", binding: "JOBS_QUEUE" }]
      // - queues.consumers: [{ queue: "radar-background-jobs-staging", max_batch_size: 10, max_batch_timeout: 30 }]
    },
    "production": {
      "name": "radartehran",
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://radartehran.example.com"
      }
    }
  }
}
