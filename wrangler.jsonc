{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radartehran",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/manifest.json",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "WORKER_ENV": "development",
    "APP_URL": "http://localhost:3000",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0713157837",
    "FIREBASE_APP_CHECK_MODE": "disabled",
    "R2_MEDIA_BUCKET_NAME": "radartehran-dev-media"
  },
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "WORKER_ENV": "preview",
      "APP_URL": "https://preview.radartehran.ir",
      "FIREBASE_PROJECT_ID": "gen-lang-client-0713157837",
      "FIREBASE_APP_CHECK_MODE": "monitor",
      "R2_MEDIA_BUCKET_NAME": "radartehran-preview-media"
    }
  },
  "env": {
    "preview": {
      "name": "radartehran-preview",
      "vars": {
        "APP_ENV": "preview",
        "WORKER_ENV": "preview",
        "APP_URL": "https://preview.radartehran.ir",
        "FIREBASE_PROJECT_ID": "gen-lang-client-0713157837",
        "FIREBASE_APP_CHECK_MODE": "monitor",
        "R2_MEDIA_BUCKET_NAME": "radartehran-preview-media"
      }
    },
    "staging": {
      "name": "radartehran-staging",
      "vars": {
        "APP_ENV": "staging",
        "WORKER_ENV": "staging",
        "APP_URL": "https://staging.radartehran.ir",
        "FIREBASE_PROJECT_ID": "gen-lang-client-0713157837",
        "ADMIN_EMAIL": "radio837isf@gmail.com",
        "FIREBASE_APP_CHECK_MODE": "monitor",
        "R2_MEDIA_BUCKET_NAME": "radartehran-staging-media",
        "STAGE_D_LIFECYCLE_ENABLED": "false",
        "STAGE_D_USER_DATABASE_ID": "fbb98e6b-5200-4047-b4bc-15a51c06aa84"
      },
      "triggers": {
        "crons": [
          "30 0 * * *",
          "30 18 * * *",
          "0 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "radartehran-staging-db",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations/d1",
          "migrations_table": "d1_migrations"
        },
        {
          "binding": "USER_DB",
          "database_name": "radar-user-db",
          "database_id": "fbb98e6b-5200-4047-b4bc-15a51c06aa84",
          "migrations_dir": "migrations/user-d1",
          "migrations_table": "d1_migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "radartehran-staging-media"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RADAR_KV",
          "id": "00000000000000000000000000000002"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "RADAR_QUEUE",
            "queue": "radartehran-staging-queue"
          },
          {
            "binding": "RADAR_DLQ",
            "queue": "radartehran-staging-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "radartehran-staging-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "radartehran-staging-dlq"
          }
        ]
      }
    },
    "production": {
      "name": "radartehran",
      "vars": {
        "APP_ENV": "production",
        "WORKER_ENV": "production",
        "APP_URL": "https://radartehran.ir",
        "FIREBASE_PROJECT_ID": "gen-lang-client-0713157837",
        "ADMIN_EMAIL": "radio837isf@gmail.com",
        "FIREBASE_APP_CHECK_MODE": "enforced"
      }
      // Production D1, R2, KV, Queue, and R2_MEDIA_BUCKET_NAME bindings are intentionally
      // omitted until provisioned by an operator with real Cloudflare resource IDs.
    }
  }
}
