{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "noEmit": true
  },
  "include": ["worker/**/*.ts"],
  "exclude": [
    "worker/**/*.test.ts",
    "worker/**/__tests__/**",
    "worker/**/tests/**",
    "node_modules",
    "dist"
  ]
}
