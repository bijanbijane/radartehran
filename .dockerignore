!.env.example
**/*service-account*.json
**/*credentials*.json
**/*.pem
**/*.p12

# VCS & IDE
.git
.gitignore
.cursor
.vscode
**/.DS_Store

# Local installs & build noise
node_modules
**/node_modules
dist
apps/api/dist
