{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radartehran-frontend",
  "account_id": "5bafb2033937006704e81afcc0b18b38",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/manifest.json",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "services": [
    {
      "binding": "RADAR_API",
      "service": "radartehran-api"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2
  },
  "vars": {
    "APP_ENV": "production",
    "WORKER_ENV": "production",
    "APP_URL": "https://radartehran-frontend.bijanbijane-1.workers.dev",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0713157837",
    "FIREBASE_APP_CHECK_MODE": "enforced"
  }
}
