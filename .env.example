ALLOW_DEMO_SEARCH_DATA=false
ADMIN_API_SECRET=
# D-H2-01: Shared secret for Express → Worker Write Admission RPC (min 16 chars; configure in deployment only)
LIFECYCLE_WRITE_ADMISSION_RPC_SECRET=
# Required for Express: base URL of the API Worker only (not the frontend Worker)
LIFECYCLE_WRITE_ADMISSION_WORKER_BASE_URL=
ADMIN_EMAIL=
BACKUP_ENCRYPTION_KEY=
FIREBASE_PROJECT_ID=
GEMINI_MODEL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_ALLOWED_HOSTS=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_MAX_IMAGE_MB=
OBJECT_STORAGE_MAX_VIDEO_MB=
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNING_SECRET=
STRANGLER_FALLBACK_ENABLED=
STRANGLER_ORIGIN_URL=
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
RADAR_DEV_SPLIT=
# API production hosting: `1` = API-only (no root dist/). `RADAR_SERVE_FRONTEND=1` enables combined static+API in NODE_ENV=production.
RADAR_API_ONLY=
# Production: .runtime-config.json disk overrides disabled unless set to 1/true
RADAR_ALLOW_RUNTIME_CONFIG_DISK=
# Exit API boot when production object storage env is incomplete (RT-INFRA-006)
RADAR_STRICT_PERSISTENCE=
# Production: disable Firestore authority for media module metadata (dev escape hatch only)
RADAR_MEDIA_METADATA_LOCAL_ONLY=
# memory | firestore_legacy (transitional) | d1 (blocked until Express adapter cutover)
RADAR_MEDIA_METADATA_BACKEND=
RADAR_OBJECT_METADATA_BACKEND=
# Production: force local index.json for object-storage metadata (forbidden with RADAR_STRICT_PERSISTENCE=1)
RADAR_OBJECT_METADATA_LOCAL_INDEX=
# Force local .cache/repositories JSON in production (not for strict prod)
RADAR_REPOSITORY_LOCAL_JSON=
# Required with authorizeProduction:true to execute geospatial snapshot migration in production
RADAR_GEO_MIGRATION_AUTHORIZE=
RADAR_SERVE_FRONTEND=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TRUST_PROXY_HOPS=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_NESHAN_API_KEY=
IRNI_API_BASE_URL=
IRNI_API_HEADER_NAME=
IRNI_API_TIMEOUT_MS=
IRNI_API_TOKEN=
INTERNAL_LIFECYCLE_RPC_SECRET=
RESEARCH_HMAC_KEY_VERSION=
RESEARCH_HMAC_PREVIOUS_SECRETS=
RESEARCH_HMAC_SECRET=
RESEARCH_K_ANONYMITY_MIN_COHORT=
APP_URL=https://radartehran-frontend.bijanbijane-1.workers.dev
