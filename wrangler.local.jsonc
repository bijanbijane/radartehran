{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radartehran-local-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "development",
    "WORKER_ENV": "development",
    "APP_URL": "http://localhost:8787",
    "ADMIN_EMAIL": "radio837isf@gmail.com",
    "STRANGLER_FALLBACK_ENABLED": "true",
    "STRANGLER_ORIGIN_URL": "http://127.0.0.1:3001",
    "LOCAL_D1_MARKETPLACE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "USER_DB",
      "database_name": "radartehran-user-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/user-d1",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "DB",
      "database_name": "radartehran-user-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/user-d1",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "RESEARCH_DB",
      "database_name": "radartehran-research-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations/research-d1",
      "migrations_table": "d1_migrations"
    }
  ]
}
