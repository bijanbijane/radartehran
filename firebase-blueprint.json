      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "LEASED", "DELIVERED", "DEAD_LETTER"] },
        "attemptCount": { "type": "number" },
        "createdAtIso": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "eventType", "schemaVersion", "status", "attemptCount", "createdAtIso"]
    },
    "SocialRateLimit": {
      "title": "SocialRateLimit",
      "description": "Shared transactional Firestore rate limit bucket counter for multi-instance social backend (zero raw UID)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bucket": { "type": "string", "enum": ["read", "create_post", "edit_post", "create_comment", "reaction", "follow", "report", "appeal", "admin"] },
