        "followingCount": { "type": "number", "description": "Server-managed following count" }
      },
      "required": ["userId", "username", "displayNameFa", "visibility"]
    },
    "SocialIdempotency": {
      "title": "SocialIdempotency",
      "description": "Server-side idempotency guard preventing duplicate social mutations",
      "type": "object",
      "properties": {
        "scope": { "type": "string" },
        "uid": { "type": "string" },
        "targetId": { "type": "string" },
        "payloadHash": { "type": "string" },
        "createdAtIso": { "type": "string", "format": "date-time" }
      },
      "required": ["scope", "uid", "targetId", "payloadHash", "createdAtIso"]
    },
    "SocialModerationCase": {
      "title": "SocialModerationCase",
      "description": "Stage 5 moderation case aggregating abuse reports, claim lease locks, decisions, and appeal SoD state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string", "enum": ["discussion_post", "question", "comment", "user"] },
        "targetId": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "CLAIMED", "DECIDED", "ESCALATED", "APPEALED", "CLOSED"] },
        "reportCount": { "type": "number" },
        "claimedByUid": { "type": "string" },
        "lastDecision": { "type": "string" },
        "updatedAtIso": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetType", "targetId", "status", "reportCount", "updatedAtIso"]
    },
    "SocialModerationEvent": {
      "title": "SocialModerationEvent",
