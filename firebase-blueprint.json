        "scope": { "type": "string", "enum": ["topic", "post", "user"] },
        "targetId": { "type": "string" },
        "followerUid": { "type": "string" },
        "createdAtIso": { "type": "string", "format": "date-time" }
      },
      "required": ["scope", "targetId", "followerUid", "createdAtIso"]
    },
    "SocialReport": {
      "title": "SocialReport",
